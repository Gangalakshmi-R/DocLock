# Copy to .env and replace every value marked CHANGE_ME.
POSTGRES_DB=doclock
POSTGRES_USER=doclock_user
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

DOCLOCK_USERNAME=admin
DOCLOCK_PASSWORD=CHANGE_ME_USE_A_STRONG_LOGIN_PASSWORD
DOCLOCK_JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
DOCLOCK_JWT_EXPIRATION=86400000

OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=220
OLLAMA_KEEP_ALIVE=30m

CHROMA_COLLECTION=doclock_vectors
CORS_ALLOWED_ORIGINS=*
