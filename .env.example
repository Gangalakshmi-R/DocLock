# Copy to .env and replace every value marked CHANGE_ME.
POSTGRES_DB=doclock
POSTGRES_USER=doclock_user
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

DOCLOCK_USERNAME=admin
# Either a strong password or (better) the pbkdf2_sha256$... value printed by:  python backend/hash_password.py
DOCLOCK_PASSWORD=CHANGE_ME_USE_A_STRONG_LOGIN_PASSWORD_OR_PBKDF2_HASH
DOCLOCK_JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
DOCLOCK_JWT_EXPIRATION=86400000

OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512
OLLAMA_KEEP_ALIVE=30m

CHROMA_COLLECTION=doclock_vectors
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DOCLOCK_CHUNK_SIZE=1000
DOCLOCK_CHUNK_OVERLAP=150
DOCLOCK_RETRIEVAL_TOP_K=5
DOCLOCK_MAX_CONTEXT_CHARS=9000
DOCLOCK_MAX_FILE_SIZE=52428800

# --- Retrieval: hybrid (BM25 + embeddings, rank-fused) | vector | lexical -----------------------
DOCLOCK_RETRIEVAL_MODE=hybrid
DOCLOCK_EMBED_BATCH_SIZE=16

# --- Document intelligence (dates, amounts, deadline alerts) -------------------------------------
# Let Llama also extract facts (output is validated against the document text). Regex extraction always runs.
DOCLOCK_LLM_FACTS=true
# 03/04/2026 means 3 April (Indian/UK style). Set false for US month-first dates.
DOCLOCK_DATES_DAY_FIRST=true
# An alert counts as "due soon" when its date is this many days away or fewer.
DOCLOCK_ALERT_WINDOW_DAYS=30

# --- Login protection ---------------------------------------------------------------------------
DOCLOCK_LOGIN_MAX_ATTEMPTS=8
DOCLOCK_LOGIN_WINDOW_SECONDS=300
