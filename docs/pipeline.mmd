flowchart TB
  subgraph ING["Ingestion (background, status is polled by the UI)"]
    direction LR
    U["Upload"] --> Q["QUEUED"] --> E["EXTRACTING<br/>Tika / plain text"] --> I["INDEXING<br/>chunk · batch-embed · store"] --> A["ANALYZING<br/>dates · amounts · deadlines"] --> P["PROCESSED"]
    E -. "error" .-> F["FAILED<br/>partial data cleaned up"]
    I -. "error" .-> F
  end

  subgraph ANA["ANALYZING in detail"]
    direction LR
    T["document text"] --> RX["Regex extractor<br/>always runs"]
    T --> LLM["Llama 3.1 JSON extractor<br/>optional"]
    LLM --> V["Grounding check<br/>drop anything not in the text"]
    RX --> M["Merge + de-duplicate"]
    V --> M
    M --> FT[("document_facts")]
    M --> AL[("document_alerts<br/>EXPIRY · DUE · RENEWAL · DEADLINE")]
  end

  subgraph QRY["Question answering"]
    direction LR
    Qn["Question"] --> EQ["Embed query"]
    Qn --> BM["BM25 keyword ranking"]
    EQ --> VR["Vector ranking<br/>Chroma, Postgres fallback"]
    VR --> RRF["Reciprocal rank fusion"]
    BM --> RRF
    RRF --> CTX["Top-k passages<br/>within a context budget"]
    CTX --> GEN["Llama 3.1 answer<br/>cites sources, abstains if unsupported"]
  end

  P ~~~ T
  AL ~~~ Qn
